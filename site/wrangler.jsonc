{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bake",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bake.juringari.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
